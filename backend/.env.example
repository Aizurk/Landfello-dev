# Landfello API — set these in Render Dashboard → Environment
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com

# Optional Paystack TEST/LIVE keys (leave blank for mock checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
CURRENCY=NGN
USD_TO_LOCAL_RATE=1600

# Optional — Dockerfile defaults to sqlite:////data/landfello.db
# DATABASE_URL=sqlite:////data/landfello.db
